namespace UAVDegradation

features
    Degradation {abstract}
        mandatory
            Illumination
                alternative
                    Normal {gain 1.0, bias 0}
                    Overexposed_mild {gain 1.15, bias 30}
                    Overexposed_strong {gain 1.3, bias 80}
                    Underexposed_mild {gain 0.9, bias -20}
                    Underexposed_strong {gain 0.8, bias -50}
                    LowLight {gain 0.4, bias -20}
        optional
            Blur
                or
                    MotionBlur
                        alternative
                            Motion_k7 {kernel 7, angle_min 0, angle_max 180}
                            Motion_k15 {kernel 15, angle_min 0, angle_max 180}
                            Motion_k21 {kernel 21, angle_min 0, angle_max 180}
                    DefocusBlur
                        alternative
                            Defocus_r3 {radius 3}
                            Defocus_r6 {radius 6}
            Noise
                or
                    GaussianNoise
                        alternative
                            Gauss_s5 {sigma 5.5}
                            Gauss_s15 {sigma 15}
                            Gauss_s30 {sigma 30}
                    ShotNoise
                        alternative
                            Shot_low {photons 100}
                            Shot_high {photons 20}
            Compression
                alternative
                    JPEG_q75 {quality 75}
                    JPEG_q50 {quality 50}
                    JPEG_q25 {quality 25}
            Atmosphere
                alternative
                    Haze_light {beta 0.5, airlight 220}
                    Haze_dense {beta 1.5, airlight 220}
                    Rain {streaks 200, stroke_length 14, opacity 0.25}
            Altitude
                alternative
                    Downscale_x1_5 {factor 1.5}
                    Downscale_x2 {factor 2.0}
            RollingShutter {max_shift_fraction 0.008, waves 2}

constraints
    LowLight => ShotNoise
    Rain => !Overexposed_strong & !Overexposed_mild
    Haze_dense => !Overexposed_strong
    RollingShutter => MotionBlur
    Shot_high => LowLight | Underexposed_strong
